# Tu dominio (debe apuntar a la IP del servidor). Caddy pondrá HTTPS automáticamente.
DOMAIN=cine.tudominio.com

# Nombre que se muestra en la web y la app
SITE_NAME=NubeCine

# Nombre del remoto que creaste con "rclone config" y carpetas dentro de Jottacloud
RCLONE_REMOTE=jotta:
MOVIES_PATH=NubeCine/Peliculas
SERIES_PATH=NubeCine/Series

# Código que tendrá que escribir cada persona para registrarse (se puede cambiar luego en Admin > Ajustes)
INVITE_CODE=cambia-este-codigo

# Opcional: clave gratuita de https://www.themoviedb.org para carátulas y sinopsis automáticas
TMDB_API_KEY=

# Único usuario administrador (déjalo vacío para que lo sea el primero que se registre)
ADMIN_USER=

# Cada cuántos minutos se buscan vídeos nuevos en Jottacloud
AUTO_SCAN_MINUTES=1

# Países desde los que se puede entrar (códigos de 2 letras separados por comas; vacío = todo el mundo)
GEO_COUNTRIES=ES
